---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — abh1"
  description="This page does not exist."
>
  <div class="mx-auto max-w-4xl px-5 pt-16 sm:px-6 sm:pt-24">
    <div class="flex min-h-[50vh] flex-col justify-center">
      <p class="font-mono text-sm tabular-nums text-zinc-500">404</p>
      <h1
        class="mt-3 text-balance text-4xl font-semibold tracking-[-0.03em] text-zinc-50 sm:text-5xl"
      >
        Nothing built at this address.
      </h1>
      <p class="mt-5 max-w-[52ch] leading-relaxed text-zinc-400">
        The page you asked for was never flashed &mdash; or it was wiped in a clean
        build.
      </p>
      <div class="mt-8">
        <a
          href="/"
          class="inline-flex rounded-lg bg-zinc-50 px-4 py-2 text-sm font-medium text-zinc-950 transition-colors duration-150 hover:bg-zinc-300"
        >
          Back home
        </a>
      </div>
    </div>
  </div>
</Base>
