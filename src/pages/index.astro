---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import CopyEmailButton from '../components/CopyEmailButton.astro';
import { getCollection } from 'astro:content';
import { socials, formatDate, site } from '../data/site';
import { projects } from '../data/projects';
import { getRepos, langColor } from '../lib/github';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = projects.filter((p) => p.featured).slice(0, 4);

const repos = await getRepos(4);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'abh1',
  alternateName: 'abh1-0',
  url: 'https://abh1.xyz/',
  image: 'https://abh1.xyz/avatar.png',
  jobTitle: 'Software Engineer & Full-Stack Architect',
  sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href)
};
---

<Base schema={personSchema}>
  <div class="mx-auto max-w-4xl px-5 sm:px-6">
    <!-- Hero Section -->
    <section class="pb-16 pt-12 sm:pt-20">
      <div class="flex items-center justify-between rise rise-1">
        <img
          src="/avatar.png"
          alt="abh1 avatar"
          width="80"
          height="80"
          class="h-20 w-20 rounded-2xl ring-1 ring-white/10 shadow-lg object-cover"
        />
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Available for Select Projects
        </div>
      </div>

      <h1
        class="rise rise-2 mt-8 max-w-[20ch] text-balance text-4xl font-semibold tracking-[-0.03em] text-zinc-50 sm:text-5xl lg:text-6xl"
      >
        Crafting high-performance web software, developer tools & systems.
      </h1>

      <p class="rise rise-3 mt-6 max-w-[62ch] text-lg leading-relaxed text-zinc-400">
        I&rsquo;m <strong class="text-zinc-200">abh1</strong> &mdash; a software engineer building elegant web platforms, real-time telemetry tools, and open-source infrastructure. Focused on clean architecture, low-latency interfaces, and high visual craft.
      </p>

      <div class="rise rise-4 mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/work"
          class="inline-flex items-center gap-2 rounded-lg bg-zinc-50 px-4 py-2.5 text-sm font-medium text-zinc-950 transition-colors duration-150 hover:bg-zinc-200"
        >
          <span>Explore Featured Work</span>
          <Icon name="arrow-up-right" class="h-4 w-4" />
        </a>
        <a
          href="https://github.com/abh1-0"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 text-sm font-medium text-zinc-200 transition-colors duration-150 hover:bg-white/[0.07]"
        >
          <Icon name="github" class="h-4 w-4" />
          <span>github.com/abh1-0</span>
        </a>
        <CopyEmailButton />
      </div>

      <!-- Quick Metrics Bar -->
      <div class="rise rise-5 mt-14 grid grid-cols-2 gap-4 rounded-xl border border-white/[0.08] bg-white/[0.02] p-4 sm:grid-cols-4 sm:p-5">
        <div>
          <span class="block text-2xl font-bold font-mono tracking-tight text-zinc-100">6+</span>
          <span class="text-xs text-zinc-400">Featured Projects</span>
        </div>
        <div>
          <span class="block text-2xl font-bold font-mono tracking-tight text-zinc-100">100%</span>
          <span class="text-xs text-zinc-400">Open Source</span>
        </div>
        <div>
          <span class="block text-2xl font-bold font-mono tracking-tight text-zinc-100">&lt;16ms</span>
          <span class="text-xs text-zinc-400">Target UI Frame Rate</span>
        </div>
        <div>
          <span class="block text-2xl font-bold font-mono tracking-tight text-zinc-100">WCAG AA</span>
          <span class="text-xs text-zinc-400">Accessibility Standard</span>
        </div>
      </div>
    </section>

    <!-- Featured Projects Showcase (With Images) -->
    <section aria-labelledby="projects-heading" class="mt-12">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <h2 id="projects-heading" class="text-2xl font-semibold tracking-tight text-zinc-50">
            Featured Projects
          </h2>
          <p class="mt-1 text-sm text-zinc-400">Bespoke web applications, developer tools, and systems software.</p>
        </div>
        <a
          href="/work"
          class="group inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-colors duration-150 hover:text-zinc-100"
        >
          View all work
          <Icon
            name="arrow-up-right"
            class="h-3.5 w-3.5 transition-transform duration-150 group-hover:-translate-y-px group-hover:translate-x-px"
          />
        </a>
      </div>

      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        {featuredProjects.map((project, idx) => (
          <ProjectCard project={project} priority={idx < 2} />
        ))}
      </div>
    </section>

    <!-- Technical Core Competencies -->
    <section aria-labelledby="skills-heading" class="mt-24">
      <h2 id="skills-heading" class="text-2xl font-semibold tracking-tight text-zinc-50">
        Core Capabilities
      </h2>
      <p class="mt-1 text-sm text-zinc-400">Engineering domains and modern stack expertise.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-zinc-200">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="mt-4 font-medium text-zinc-100">Full-Stack Web</h3>
          <p class="mt-2 text-xs leading-relaxed text-zinc-400">
            Building performant web platforms using TypeScript, Astro, Next.js, React, Tailwind CSS, and WebAssembly.
          </p>
        </div>

        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-zinc-200">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="mt-4 font-medium text-zinc-100">Developer Tools</h3>
          <p class="mt-2 text-xs leading-relaxed text-zinc-400">
            Creating high-velocity developer workspaces, design systems, visual IDEs, and CLI utilities.
          </p>
        </div>

        <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-zinc-200">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
          <h3 class="mt-4 font-medium text-zinc-100">Systems & Networks</h3>
          <p class="mt-2 text-xs leading-relaxed text-zinc-400">
            Low-level optimization, Chromium browser tuning, power governors, network protocol engines, and C++/Rust modules.
          </p>
        </div>
      </div>
    </section>

    <!-- Open Source Repositories -->
    <section aria-labelledby="repos-heading" class="mt-24">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="repos-heading" class="text-xl font-semibold tracking-tight text-zinc-50">
          Open Source Repositories
        </h2>
        <a
          href="https://github.com/abh1-0"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-colors duration-150 hover:text-zinc-100"
        >
          GitHub Profile
          <Icon
            name="arrow-up-right"
            class="h-3.5 w-3.5 transition-transform duration-150 group-hover:-translate-y-px group-hover:translate-x-px"
          />
        </a>
      </div>
      <ul class="mt-6">
        {
          repos.map((repo) => (
            <li class="border-t border-white/[0.06] last:border-b">
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block py-5"
              >
                <div class="flex items-baseline justify-between gap-4">
                  <span class="min-w-0">
                    <span class="inline-flex items-center gap-1.5 font-medium text-zinc-100 transition-colors duration-150 group-hover:text-white">
                      {repo.name}
                      <Icon
                        name="arrow-up-right"
                        class="h-3.5 w-3.5 text-zinc-500 transition-all duration-150 group-hover:-translate-y-px group-hover:translate-x-px group-hover:text-zinc-300"
                      />
                    </span>
                    {repo.description && (
                      <span class="mt-1 block truncate text-sm text-zinc-400 sm:whitespace-normal">
                        {repo.description}
                      </span>
                    )}
                  </span>
                  <span class="hidden shrink-0 items-center gap-4 sm:flex">
                    {repo.language && (
                      <span class="flex items-center gap-1.5 text-[13px] text-zinc-400">
                        <span
                          class="h-2.5 w-2.5 rounded-full"
                          style={`background-color: ${langColor(repo.language)}`}
                          aria-hidden="true"
                        />
                        {repo.language}
                      </span>
                    )}
                    {repo.stars !== null && repo.stars > 0 && (
                      <span class="w-10 text-right font-mono text-[13px] tabular-nums text-zinc-500">
                        ★ {repo.stars}
                      </span>
                    )}
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Writing / Blog -->
    {
      posts.length > 0 && (
        <section aria-labelledby="writing-heading" class="mt-24">
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="writing-heading" class="text-xl font-semibold tracking-tight text-zinc-50">
              Technical Writing
            </h2>
            <a
              href="/blog"
              class="group inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-colors duration-150 hover:text-zinc-100"
            >
              All articles
              <Icon
                name="arrow-up-right"
                class="h-3.5 w-3.5 transition-transform duration-150 group-hover:-translate-y-px group-hover:translate-x-px"
              />
            </a>
          </div>
          <ul class="mt-6">
            {posts.map((post) => (
              <li class="border-t border-white/[0.06] last:border-b">
                <a href={`/blog/${post.id}/`} class="group block py-5">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-6">
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="font-mono text-[13px] tabular-nums text-zinc-500 sm:w-28 sm:shrink-0"
                    >
                      {formatDate(post.data.pubDate)}
                    </time>
                    <span class="min-w-0">
                      <span class="block font-medium text-zinc-100 transition-colors duration-150 group-hover:text-white">
                        {post.data.title}
                      </span>
                      <span class="mt-1 line-clamp-2 block text-sm leading-relaxed text-zinc-400">
                        {post.data.description}
                      </span>
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Elsewhere & Contact -->
    <section aria-labelledby="elsewhere-heading" class="mt-24">
      <h2 id="elsewhere-heading" class="text-xl font-semibold tracking-tight text-zinc-50">
        Connect & Elsewhere
      </h2>
      <p class="mt-1 text-sm text-zinc-400">Feel free to reach out for inquiries or collaboration.</p>

      <ul class="mt-6 flex flex-wrap items-center gap-2.5">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                aria-label={social.label}
                title={social.label}
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-zinc-400 transition-colors duration-150 hover:bg-white/[0.08] hover:text-zinc-100"
              >
                <Icon name={social.icon} class="h-[17px] w-[17px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <!-- Lightbox Modal for Screenshots -->
  <ProjectModal />
</Base>
