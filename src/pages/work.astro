---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getRepos, langColor } from '../lib/github';
import { site } from '../data/site';

const repos = await getRepos(16);
---

<Base
  title="Work & Open Source — abh1"
  description="Personal engineering portfolio featuring open-source software, developer tools, and systems projects by abh1."
>
  <div class="mx-auto max-w-4xl px-5 pt-12 sm:px-6 sm:pt-20">
    <!-- Header section -->
    <div class="max-w-2xl border-b border-white/[0.08] pb-10">
      <h1 class="text-balance text-4xl font-semibold tracking-[-0.03em] text-zinc-50 sm:text-5xl">
        Work & Open Source
      </h1>
      <p class="mt-4 text-base leading-relaxed text-zinc-400">
        A collection of open-source projects, developer tools, performance governors, and network protocol utilities maintained on GitHub.
      </p>
    </div>

    <!-- Open Source Repositories Section -->
    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-50">
            GitHub Repositories
          </h2>
          <p class="mt-1 text-sm text-zinc-400">Public repositories and open infrastructure maintained under @abh1-0.</p>
        </div>
        <a
          href="https://github.com/abh1-0"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-colors duration-150 hover:text-zinc-100"
        >
          github.com/abh1-0
          <Icon
            name="arrow-up-right"
            class="h-3.5 w-3.5 transition-transform duration-150 group-hover:-translate-y-px group-hover:translate-x-px"
          />
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          repos.map((repo) => (
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col justify-between rounded-xl border border-white/[0.08] bg-white/[0.02] p-5 transition-all duration-200 hover:border-white/[0.18] hover:bg-white/[0.04]"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="inline-flex items-center gap-1.5 font-semibold text-zinc-100 transition-colors group-hover:text-white">
                    {repo.name}
                    <Icon
                      name="arrow-up-right"
                      class="h-3.5 w-3.5 text-zinc-500 transition-all duration-150 group-hover:-translate-y-px group-hover:translate-x-px group-hover:text-zinc-300"
                    />
                  </span>
                  {repo.stars !== null && repo.stars > 0 && (
                    <span class="inline-flex items-center gap-1 font-mono text-xs text-amber-400">
                      ★ {repo.stars}
                    </span>
                  )}
                </div>
                {repo.description && (
                  <p class="mt-2.5 text-xs leading-relaxed text-zinc-400">
                    {repo.description}
                  </p>
                )}
              </div>

              <div class="mt-5 flex items-center gap-3 pt-3 border-t border-white/[0.04]">
                {repo.language && (
                  <span class="flex items-center gap-1.5 font-mono text-xs text-zinc-400">
                    <span
                      class="h-2 w-2 rounded-full"
                      style={`background-color: ${langColor(repo.language)}`}
                      aria-hidden="true"
                    />
                    {repo.language}
                  </span>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Footer CTA -->
    <div class="mt-16 rounded-xl border border-white/[0.08] bg-white/[0.02] p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <h3 class="text-lg font-semibold text-zinc-100">Interested in working together?</h3>
        <p class="mt-1 text-sm text-zinc-400">Available for architecture design, frontend engineering, and technical advisory.</p>
      </div>
      <a
        href={`mailto:${site.email}`}
        class="inline-flex shrink-0 items-center justify-center rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-semibold text-zinc-950 transition-colors hover:bg-white"
      >
        Get in touch
      </a>
    </div>
  </div>
</Base>
