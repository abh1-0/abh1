---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { projects, projectCategories } from '../data/projects';
import { getRepos, langColor } from '../lib/github';

const repos = await getRepos(12);
---

<Base
  title="Work & Projects — abh1"
  description="Personal engineering portfolio featuring web applications, developer tools, systems software, and open-source protocols by abh1."
>
  <div class="mx-auto max-w-4xl px-5 pt-12 sm:px-6 sm:pt-20">
    <!-- Header section -->
    <div class="max-w-2xl">
      <h1 class="text-balance text-4xl font-semibold tracking-[-0.03em] text-zinc-50 sm:text-5xl">
        Work & Projects
      </h1>
      <p class="mt-4 text-base leading-relaxed text-zinc-400">
        A curated showcase of software products, developer tools, high-performance systems, and open-source libraries I&rsquo;ve engineered.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="mt-10 border-b border-white/[0.08] pb-4">
      <nav class="flex flex-wrap gap-2" aria-label="Project Categories" id="category-tabs">
        {
          projectCategories.map((cat, idx) => (
            <button
              type="button"
              data-category-filter={cat}
              class={`rounded-lg px-3 py-1.5 text-xs font-medium transition-all duration-150 ${
                idx === 0
                  ? 'bg-zinc-100 text-zinc-950 font-semibold shadow-sm'
                  : 'border border-white/10 bg-white/[0.03] text-zinc-400 hover:border-white/20 hover:text-zinc-100'
              }`}
            >
              {cat}
            </button>
          ))
        }
      </nav>
    </div>

    <!-- Featured Projects Grid -->
    <div class="mt-8 grid gap-8 sm:grid-cols-2" id="projects-grid">
      {
        projects.map((project, idx) => (
          <ProjectCard project={project} priority={idx < 4} />
        ))
      }
    </div>

    <!-- Open Source Repositories Section -->
    <section class="mt-24 border-t border-white/[0.08] pt-12">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-50">
            Open Source Code
          </h2>
          <p class="mt-1 text-sm text-zinc-400">Repositories and open infrastructure maintained on GitHub.</p>
        </div>
        <a
          href="https://github.com/abh1-0"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 text-sm text-zinc-400 transition-colors duration-150 hover:text-zinc-100"
        >
          github.com/abh1-0
          <Icon
            name="arrow-up-right"
            class="h-3.5 w-3.5 transition-transform duration-150 group-hover:-translate-y-px group-hover:translate-x-px"
          />
        </a>
      </div>

      <ul class="mt-8">
        {
          repos.map((repo) => (
            <li class="border-t border-white/[0.06] last:border-b">
              <a
                href={repo.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block py-6"
              >
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <span class="inline-flex items-center gap-1.5 font-medium text-zinc-100 transition-colors duration-150 group-hover:text-white">
                    {repo.name}
                    <Icon
                      name="arrow-up-right"
                      class="h-3.5 w-3.5 text-zinc-500 transition-all duration-150 group-hover:-translate-y-px group-hover:translate-x-px group-hover:text-zinc-300"
                    />
                  </span>
                  <span class="flex items-center gap-4 font-mono text-[13px] tabular-nums text-zinc-500">
                    {repo.language && (
                      <span class="flex items-center gap-1.5">
                        <span
                          class="h-2.5 w-2.5 rounded-full"
                          style={`background-color: ${langColor(repo.language)}`}
                          aria-hidden="true"
                        />
                        {repo.language}
                      </span>
                    )}
                    {repo.stars !== null && repo.stars > 0 && <span>★ {repo.stars}</span>}
                  </span>
                </div>
                {repo.description && (
                  <p class="mt-1 max-w-[62ch] text-sm leading-relaxed text-zinc-400">
                    {repo.description}
                  </p>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Footer CTA -->
    <div class="mt-16 rounded-xl border border-white/[0.08] bg-white/[0.02] p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <h3 class="text-lg font-semibold text-zinc-100">Interested in working together?</h3>
        <p class="mt-1 text-sm text-zinc-400">Available for architecture design, frontend engineering, and technical advisory.</p>
      </div>
      <a
        href="mailto:contact@abh1.xyz"
        class="inline-flex shrink-0 items-center justify-center rounded-lg bg-zinc-100 px-4 py-2.5 text-sm font-semibold text-zinc-950 transition-colors hover:bg-white"
      >
        Get in touch
      </a>
    </div>
  </div>

  <ProjectModal />
</Base>

<script>
  function initFilters() {
    const tabButtons = document.querySelectorAll('[data-category-filter]');
    const articles = document.querySelectorAll('#projects-grid article');

    if (!tabButtons.length || !articles.length) return;

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category-filter');
        if (!category) return;

        // Update active button state
        tabButtons.forEach((b) => {
          b.classList.remove('bg-zinc-100', 'text-zinc-950', 'font-semibold', 'shadow-sm');
          b.classList.add('border', 'border-white/10', 'bg-white/[0.03]', 'text-zinc-400');
        });

        btn.classList.remove('border', 'border-white/10', 'bg-white/[0.03]', 'text-zinc-400');
        btn.classList.add('bg-zinc-100', 'text-zinc-950', 'font-semibold', 'shadow-sm');

        // Filter cards
        articles.forEach((art) => {
          const artCat = art.getAttribute('data-category');
          if (category === 'All' || artCat === category) {
            (art as HTMLElement).style.display = 'flex';
          } else {
            (art as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initFilters);
</script>
