---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CopyEmailButton from '../components/CopyEmailButton.astro';
import { socials, site } from '../data/site';

const techStack = [
  {
    category: 'Frontend & UI Engineering',
    items: ['TypeScript', 'JavaScript (ESNext)', 'Astro', 'React / Next.js', 'Tailwind CSS', 'WebAssembly', 'HTML5 / CSS3', 'WCAG AA Accessibility']
  },
  {
    category: 'Systems, Tools & Languages',
    items: ['Node.js', 'Go', 'Rust', 'C / C++', 'Python', 'Shell Scripting', 'Git & GitHub Actions', 'Vite / Rollup']
  },
  {
    category: 'Backend & Data Protocols',
    items: ['REST APIs', 'GraphQL', 'WebSockets', 'mDNS & Network Protocols', 'PostgreSQL', 'Redis', 'Docker & Containers']
  },
  {
    category: 'Design & Visual Craft',
    items: ['Design Systems', 'Micro-interactions', 'Typography & Grid Systems', 'Linear/Vercel Aesthetic', 'DOM Performance', 'Figma']
  }
];

const timeline = [
  {
    period: '2024 — Present',
    role: 'Lead Full-Stack & Systems Engineer',
    organization: 'Independent / Open Source',
    description:
      'Designing high-performance web tools, custom browser shells, telemetry dashboards, and headless component systems.'
  },
  {
    period: '2023 — 2024',
    role: 'Frontend Architect & UI Engineer',
    organization: 'Web Platforms',
    description:
      'Engineered sub-16ms web interfaces, design token pipelines, and real-time canvas visualizations for web applications.'
  },
  {
    period: '2022 — 2023',
    role: 'Software & Open Source Developer',
    organization: 'Community Projects',
    description:
      'Built cross-platform network utilities, power optimization governors, and web APIs used across open-source communities.'
  }
];
---

<Base
  title="About & Skills — abh1"
  description="Engineering background, skills matrix, and career timeline of abh1 — Software Engineer & Full-Stack Architect."
>
  <div class="mx-auto max-w-4xl px-5 pt-12 sm:px-6 sm:pt-20">
    <!-- Header -->
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between border-b border-white/[0.08] pb-12">
      <div class="max-w-2xl">
        <h1 class="text-balance text-4xl font-semibold tracking-[-0.03em] text-zinc-50 sm:text-5xl">
          About & Engineering
        </h1>
        <p class="mt-4 text-base leading-relaxed text-zinc-400">
          I&rsquo;m <strong class="text-zinc-200">abh1</strong>, a software engineer with a passion for building clean, resilient, and visually captivating software.
        </p>
      </div>
      <img
        src="/avatar.png"
        alt="abh1 avatar"
        width="110"
        height="110"
        class="h-28 w-28 shrink-0 rounded-2xl ring-1 ring-white/10 shadow-xl object-cover"
      />
    </div>

    <!-- Engineering Philosophy -->
    <section class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight text-zinc-50">
        Engineering Philosophy
      </h2>
      <div class="mt-4 space-y-4 text-base leading-relaxed text-zinc-400">
        <p>
          I believe software should be fast, quiet, and durable. Whether designing a complex web dashboard, crafting a developer workbench, or writing low-level utilities, I focus on zero-bloat architecture, strict visual hierarchy, and sub-16ms responsive interactions.
        </p>
        <p>
          My work spans full-stack web platforms, developer utilities, and network protocols. I prioritize primary-source evidence, verifiable benchmarks, and immaculate user experiences over flashy trends.
        </p>
      </div>
    </section>

    <!-- Technical Stack Matrix -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold tracking-tight text-zinc-50">
        Technical Skills Matrix
      </h2>
      <p class="mt-1 text-sm text-zinc-400">Technologies and tooling I utilize daily.</p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          techStack.map((group) => (
            <div class="rounded-xl border border-white/[0.08] bg-white/[0.02] p-6">
              <h3 class="font-medium text-zinc-100 flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                {group.category}
              </h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="rounded-md border border-white/[0.08] bg-white/[0.03] px-2.5 py-1 font-mono text-xs text-zinc-300">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Experience Timeline -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold tracking-tight text-zinc-50">
        Experience & Milestones
      </h2>
      <div class="mt-8 space-y-8 border-l border-white/10 pl-6 sm:pl-8">
        {
          timeline.map((item) => (
            <div class="relative">
              <span class="absolute -left-[31px] sm:-left-[39px] top-1 h-3 w-3 rounded-full border border-zinc-950 bg-zinc-400 ring-4 ring-zinc-950"></span>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="text-lg font-semibold text-zinc-100">{item.role}</h3>
                <span class="font-mono text-xs text-zinc-400">{item.period}</span>
              </div>
              <p class="text-xs font-mono text-emerald-400 mt-0.5">{item.organization}</p>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400">{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Contact & Socials -->
    <section class="mt-20 border-t border-white/[0.08] pt-12">
      <h2 class="text-xl font-semibold tracking-tight text-zinc-50">
        Get in Touch
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-zinc-400">
        Have a project inquiry, architecture question, or opportunity? Drop me an email or connect on social platforms.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <CopyEmailButton />
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-lg bg-zinc-100 px-4 py-2 text-xs font-semibold text-zinc-950 hover:bg-white transition-colors"
        >
          Send Email Direct
        </a>
      </div>

      <ul class="mt-8 flex flex-wrap items-center gap-2.5">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                aria-label={social.label}
                title={social.label}
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/[0.03] text-zinc-400 transition-colors duration-150 hover:bg-white/[0.08] hover:text-zinc-100"
              >
                <Icon name={social.icon} class="h-[17px] w-[17px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
