---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import {
  absoluteUrl,
  OG_IMAGE_ALT,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_URL,
  OG_IMAGE_WIDTH
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  schema?: Record<string, unknown>;
}

const {
  title = site.title,
  description = site.description,
  image = OG_IMAGE_URL,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  tags,
  noindex = false,
  schema
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = new URL(image, Astro.site).toString();
const jsonLd = schema ? JSON.stringify(schema).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content={`Abhiram Vunnava, abh1, ${site.name}.xyz, Abhiram Vunnava portfolio, software engineer Hyderabad, ${site.role}`}
    />
    <meta name="author" content={`${site.legalName} (${site.name})`} />
    {!noindex && <meta name="robots" content="index, follow" />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="geo.region" content={`IN-${site.location.regionCode}`} />
    <meta name="geo.placename" content={site.location.city} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${site.legalName} (${site.name})`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content={new URL('/', Astro.site).toString()} />
    )}
    {tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <!--
      DIRECTION CONTRACT — brief-pinned canon (dark developer portfolio; craft bar: Vercel, Tailwind, Linear).
      THESIS: A build log, not a landing page. Refuses the centered hero-card portfolio; everything reads as evidence — repos, dates, counts — set in a quiet near-black system where typography does the work.
      OWN-WORLD: #09090b ground, zinc type hierarchy, 1px white hairlines, Geist + Geist Mono, no gradients, no glow, no accent chrome; color appears only as data (language dots).
      STORY: A visitor confirms real Android platform work within seconds, then either opens a repository or starts reading.
      FIRST VIEWPORT: Left-aligned avatar (80px), display headline "Building Android from source.", two-line claim, primary button "Read the writing", ghost button to GitHub. No eyebrow labels; headings carry their own weight.
      FORM: Single-column editorial list grammar (hairline rows, mono data column) across home, writing index, and work. Signature motion: one staggered rise on the hero, none elsewhere.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-zinc-100 focus:px-3 focus:py-2 focus:text-sm focus:text-zinc-950"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
